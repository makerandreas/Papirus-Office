# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_CSE_CX: Google Custom Search Engine CX
GOOGLE_CSE_CX=YOUR_CSE_CX

# GOOGLE_CSE_API_KEY: Primary API key for Template Search & Google Fonts REST API (Gemini API restricted)
GOOGLE_CSE_API_KEY=YOUR_CSE_API_KEY

# GOOGLE_FONTS_REST_API: Fallback API key for Template Search & Google Fonts REST API (Discovery Engine & Telemetry APIs restricted)
GOOGLE_FONTS_REST_API=YOUR_FONTS_REST_API
