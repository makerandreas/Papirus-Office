<?xml version="1.0" encoding="utf-8"?>
<!--
   FileProvider paths, deliberately scoped to app-private directories only.
   Never expose shared/external storage roots here.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache_files" path="." />
    <files-path name="internal_files" path="." />
    <external-files-path name="app_external_files" path="." />
    <external-cache-path name="app_external_cache" path="." />
</paths>
